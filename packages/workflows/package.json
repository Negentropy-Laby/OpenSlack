{
  "name": "@openslack/workflows",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workflow-runner-worker": {
      "types": "./dist/workflow-runner-worker-public.d.ts",
      "import": "./dist/workflow-runner-worker-public.js"
    },
    "./internal/workflow-source-snapshot": {
      "types": "./dist/internal/workflow-source-snapshot.d.ts",
      "import": "./dist/internal/workflow-source-snapshot.js"
    }
  },
  "bin": {
    "openslack-workflow-runner": "./dist/workflow-runner-worker-bin.js"
  },
  "scripts": {
    "pretest": "bun run --cwd ../.. build",
    "build:runner-worker": "bun ../../scripts/qualification/workflow-runner-bundle.ts build",
    "typecheck": "tsc",
    "test": "cd ../.. && vitest run --project @openslack/workflows",
    "test:watch": "cd ../.. && vitest --project @openslack/workflows"
  },
  "dependencies": {
    "@openslack/core": "workspace:*",
    "@openslack/kernel": "workspace:*",
    "@openslack/runtime": "workspace:*",
    "@openslack/github": "workspace:*",
    "@openslack/pr": "workspace:*",
    "@openslack/collaboration": "workspace:*",
    "@openslack/workspace": "workspace:*",
    "@openslack/agent-runtime": "workspace:*",
    "yaml": "^2.7.0"
  }
}
