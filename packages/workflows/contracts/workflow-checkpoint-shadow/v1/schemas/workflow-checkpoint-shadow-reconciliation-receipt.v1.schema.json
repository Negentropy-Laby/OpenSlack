{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openslack.dev/contracts/workflow-checkpoint-shadow/v1/schemas/workflow-checkpoint-shadow-reconciliation-receipt.v1.schema.json",
  "title": "OpenSlack reconciliation-required Workflow checkpoint shadow receipt v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "openslack.workflow_checkpoint_shadow_receipt.v1" },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^openslack\\.workflow-checkpoint-shadow\\.v1\\.[0-9a-f]{64}$"
    },
    "receiptId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,255}$" },
    "workspaceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,255}$" },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,255}$" },
    "sourceSequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740990 },
    "operation": { "enum": ["checkpoint_commit", "resume_advance"] },
    "envelopeHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "observationHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "serviceBuildHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "const": "reconciliation_required" },
    "observationId": { "type": "null" },
    "parity": { "const": "unknown" },
    "mismatchCode": { "type": "null" },
    "reconciliationToken": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,255}$" },
    "committedAt": { "type": "null" }
  },
  "required": [
    "schema",
    "idempotencyKey",
    "receiptId",
    "workspaceId",
    "runId",
    "sourceSequence",
    "operation",
    "envelopeHash",
    "observationHash",
    "serviceBuildHash",
    "status",
    "observationId",
    "parity",
    "mismatchCode",
    "reconciliationToken",
    "committedAt"
  ]
}
