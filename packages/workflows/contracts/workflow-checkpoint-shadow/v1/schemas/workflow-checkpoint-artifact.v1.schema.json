{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openslack.dev/contracts/workflow-checkpoint-shadow/v1/schemas/workflow-checkpoint-artifact.v1.schema.json",
  "title": "OpenSlack local Workflow checkpoint artifact v1",
  "$comment": "Local-only opaque bytes. artifactHash is sha256(decoded bytes); artifact content never crosses the Go observation boundary.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "openslack.workflow_checkpoint_artifact.v1" },
    "artifactHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bytesBase64": {
      "type": "string",
      "maxLength": 5592408,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  },
  "required": ["schema", "artifactHash", "bytesBase64"]
}
