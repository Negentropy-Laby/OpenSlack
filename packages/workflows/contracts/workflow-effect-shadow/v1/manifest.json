    "acceptedStatuses": [200, 201],
    "reconciliationStatus": 202,
    "replayHeader": "Idempotency-Replayed: true"
  },
  "variants": { "receipt": ["accepted_matched", "accepted_mismatched", "reconciliation_required"] },
