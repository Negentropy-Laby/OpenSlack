{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openslack.dev/contracts/governed-plan/v1/governed-action-plan.v1.schema.json",
  "title": "OpenSlack governed action plan v1",
  "$comment": "Structural prefilter only. Runtime validators enforce UTF-8 bytes, depth, nodes, inert values, and ECMAScript string semantics.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "openslack.governed_action_plan.v1" },
    "kind": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "goal": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "input": { "$ref": "#/$defs/governedJson" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actionId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
          "input": { "$ref": "#/$defs/governedJson" }
        },
        "required": ["actionId", "input"]
      }
    },
    "effects": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
          "summary": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "risk": { "enum": ["low", "medium", "high"] },
          "target": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:@/-]{0,255}$" }
        },
        "required": ["type", "summary", "risk"]
      }
    }
  },
  "required": ["schema", "kind", "goal", "input", "actions", "effects"],
  "$defs": {
    "governedJson": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 65536 },
        { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/governedJson" } },
        {
          "type": "object",
          "maxProperties": 1000,
          "propertyNames": {
            "maxLength": 256,
            "not": { "enum": ["__proto__", "prototype", "constructor"] }
          },
          "additionalProperties": { "$ref": "#/$defs/governedJson" }
        }
      ]
    }
  }
}
