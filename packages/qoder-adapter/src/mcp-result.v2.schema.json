{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openslack.dev/schemas/mcp-result.v2.schema.json",
  "title": "OpenSlack MCP Result v2",
  "$defs": {
    "jsonPrimitive": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" }
      ]
    },
    "canonicalTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
    },
    "inertJson0": {
      "anyOf": [
        { "$ref": "#/$defs/jsonPrimitive" },
        {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/inertJson1" }
        },
        {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": { "$ref": "#/$defs/inertJson1" }
        }
      ]
    },
    "inertJson1": {
      "anyOf": [
        { "$ref": "#/$defs/jsonPrimitive" },
        {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/inertJson2" }
        },
        {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": { "$ref": "#/$defs/inertJson2" }
        }
      ]
    },
    "inertJson2": {
      "anyOf": [
        { "$ref": "#/$defs/jsonPrimitive" },
        {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/inertJson3" }
        },
        {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": { "$ref": "#/$defs/inertJson3" }
        }
      ]
    },
    "inertJson3": {
      "anyOf": [
        { "$ref": "#/$defs/jsonPrimitive" },
        {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/inertJson4" }
        },
        {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": { "$ref": "#/$defs/inertJson4" }
        }
      ]
    },
    "inertJson4": {
      "anyOf": [
        { "$ref": "#/$defs/jsonPrimitive" },
        {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/inertJson5" }
        },
        {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": { "$ref": "#/$defs/inertJson5" }
        }
      ]
    },
    "inertJson5": {
      "anyOf": [
        { "$ref": "#/$defs/jsonPrimitive" },
        {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/inertJson6" }
        },
        {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": { "$ref": "#/$defs/inertJson6" }
        }
      ]
    },
    "inertJson6": {
      "anyOf": [
        { "$ref": "#/$defs/jsonPrimitive" },
        {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/inertJson7" }
        },
        {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": { "$ref": "#/$defs/inertJson7" }
        }
      ]
    },
    "inertJson7": {
      "anyOf": [
        { "$ref": "#/$defs/jsonPrimitive" },
        {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/inertJson8" }
        },
        {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": { "$ref": "#/$defs/inertJson8" }
        }
      ]
    },
    "inertJson8": {
      "anyOf": [
        { "$ref": "#/$defs/jsonPrimitive" },
        {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/inertJson9" }
        },
        {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": { "$ref": "#/$defs/inertJson9" }
        }
      ]
    },
    "inertJson9": {
      "anyOf": [
        { "$ref": "#/$defs/jsonPrimitive" },
        {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/inertJson10" }
        },
        {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": { "$ref": "#/$defs/inertJson10" }
        }
      ]
    },
    "inertJson10": {
      "anyOf": [
        { "$ref": "#/$defs/jsonPrimitive" },
        {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/inertJson11" }
        },
        {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": { "$ref": "#/$defs/inertJson11" }
        }
      ]
    },
    "inertJson11": {
      "anyOf": [
        { "$ref": "#/$defs/jsonPrimitive" },
        {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/inertJson12" }
        },
        {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": { "$ref": "#/$defs/inertJson12" }
        }
      ]
    },
    "inertJson12": {
      "anyOf": [
        { "$ref": "#/$defs/jsonPrimitive" },
        { "type": "array", "maxItems": 0 },
        { "type": "object", "maxProperties": 0, "additionalProperties": false }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "correlationId",
    "status",
    "summary",
    "authority",
    "governance",
    "nextActions",
    "evidenceRefs"
  ],
  "properties": {
    "schema": { "const": "openslack.mcp_result.v2" },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "status": {
      "enum": ["completed", "preview", "needs_confirmation", "blocked", "failed"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "sources", "observedAt"],
      "properties": {
        "mode": { "enum": ["projection", "governed_mutation"] },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/?#@+-]*$"
          }
        },
        "observedAt": { "$ref": "#/$defs/canonicalTimestamp" }
      }
    },
    "data": { "$ref": "#/$defs/inertJson0" },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "approvalRequired"],
      "properties": {
        "risk": { "enum": ["none", "low", "medium", "high"] },
        "approvalRequired": { "type": "boolean" },
        "approvalKind": {
          "enum": [
            "openslack_confirm",
            "openslack_workflow_effect",
            "github_human_review",
            "workflow_trust"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "blocker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        }
      }
    },
    "nextActions": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "requiresConfirmation"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
          },
          "tool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
          },
          "arguments": {
            "type": "object",
            "maxProperties": 1000,
            "additionalProperties": { "$ref": "#/$defs/inertJson1" }
          },
          "requiresConfirmation": { "type": "boolean" }
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 512,
        "pattern": "^(?:(?:event|query|artifact|test|repo|workflow-run|run|plan|issue|pr|decision|handoff|notification|assumption|fixture):[A-Za-z0-9][A-Za-z0-9._~:/@+?%=&-]{0,499}|commit:[0-9A-Fa-f]{40}|repo:(?=[^#]{1,374}#)(?:(?!\\.{1,2}/)[A-Za-z0-9._-]+/)*(?!\\.{1,2}#)[A-Za-z0-9._-]+#[A-Za-z0-9][A-Za-z0-9._-]{0,63}@[A-Za-z0-9][A-Za-z0-9._-]{0,63})$"
      }
    },
    "planId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "planHash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "confirmationToken": {
      "type": "string",
      "minLength": 32,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "executionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvalId", "kind", "expiresAt", "risk"],
      "properties": {
        "approvalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "kind": { "const": "openslack_workflow_effect" },
        "expiresAt": { "$ref": "#/$defs/canonicalTimestamp" },
        "risk": { "enum": ["low", "medium", "high"] }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "planHash": true },
        "required": ["planHash"]
      },
      "then": {
        "properties": { "planId": true },
        "required": ["planId"]
      }
    },
    {
      "if": {
        "properties": { "confirmationToken": true },
        "required": ["confirmationToken"]
      },
      "then": {
        "required": ["planId", "planHash"],
        "properties": {
          "planId": true,
          "planHash": true,
          "status": { "const": "needs_confirmation" },
          "authority": {
            "type": "object",
            "properties": {
              "mode": { "const": "governed_mutation" }
            }
          },
          "governance": {
            "type": "object",
            "required": ["approvalKind"],
            "properties": {
              "approvalRequired": { "const": true },
              "approvalKind": { "const": "openslack_confirm" }
            }
          }
        }
      }
    }
  ]
}
