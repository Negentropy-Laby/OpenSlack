{
  "name": "@openslack/core",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./internal/strict-json": {
      "types": "./dist/strict-json.d.ts",
      "import": "./dist/strict-json.js"
    },
    "./internal/runtime-contracts": {
      "types": "./dist/runtime-contracts.d.ts",
      "import": "./dist/runtime-contracts.js"
    },
    "./internal/owned-file": {
      "types": "./dist/owned-file.d.ts",
      "import": "./dist/owned-file.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run --root ../.. --project @openslack/core",
    "test:watch": "vitest --root ../.. --project @openslack/core",
    "pretest": "tsc --build tsconfig.json"
  }
}
