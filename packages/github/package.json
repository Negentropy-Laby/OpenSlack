{
  "name": "@openslack/github",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bounded-json-post": {
      "types": "./dist/bounded-json-post.d.ts",
      "import": "./dist/bounded-json-post.js"
    },
    "./cleanup-broker-internal": {
      "types": "./dist/internal/cleanup-broker.d.ts",
      "import": "./dist/internal/cleanup-broker.js"
    }
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run --root ../.. --project @openslack/github",
    "test:watch": "vitest --root ../.. --project @openslack/github",
    "pretest": "tsc --build tsconfig.json"
  },
  "dependencies": {
    "@openslack/credentials": "workspace:*",
    "@openslack/kernel": "workspace:*",
    "@octokit/rest": "^21.0.0",
    "ajv": "8.17.1",
    "yaml": "^2.7.0",
    "@openslack/core": "workspace:*"
