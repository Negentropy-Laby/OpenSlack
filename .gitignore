# rc_wsman .gitignore
# Project artifacts (CDDs, ADRs, memory_bank, production/stage.txt, go.mod,
# internal/, tests/, .github/, docs/, design/, standards/) ARE tracked.
# Only tooling state, generated build output, and machine-local cruft are ignored.

# --- Project tooling state (NOT project documentation) ---
# .aby/ is agent/tooling state (sessions, history, paste-cache, .credentials.json).
.aby/
# .claude/ contains local planning/recon state and is not a durable submission artifact.
.claude/
# Ephemeral CDD workflow adapter - "gitignored in CDD", not a durable artifact.
# production/stage.txt (the authoritative stage token) is NOT ignored.
production/session-state/

# --- Go build, test, and coverage artifacts ---
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.prof
*.out
coverage.txt
coverage.html
*.coverprofile
# vendor/ is generated by `go mod vendor` if ever used.
vendor/
# go.sum is generated and IS tracked; nothing to ignore there.
# Local module cache populated by Docker-based Go runs (GOMODCACHE).
.gomodcache/
# Local build cache populated by Docker-based Go runs (GOCACHE).
.gocache/

# --- Secrets / environment (CTRL-016: pepper value never persisted) ---
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.p12
*.pfx

# --- Editor / IDE ---
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.code-workspace

# --- OS cruft ---
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Logs and temp ---
*.log
logs/
*.tmp
*.temp
