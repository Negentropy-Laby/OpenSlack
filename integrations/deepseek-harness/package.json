{
  "name": "@openslack/deepseek-harness-plugin",
  "version": "0.2.0",
  "type": "module",
  "description": "OpenSlack task scopes, native MCP and a public-SDK Bridge peer for unmodified DeepSeek Harness",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": { "types": "./dist/types/src/index.d.ts", "default": "./dist/index.js" },
    "./initiator": { "types": "./dist/types/src/initiator.d.ts", "default": "./dist/initiator.js" },
    "./readonly": { "types": "./dist/types/src/readonly.d.ts", "default": "./dist/readonly.js" },
    "./sdk-host": { "types": "./dist/types/src/sdk-host.d.ts", "default": "./dist/sdk-host.js" },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["dist/index.js", "dist/initiator.js", "dist/readonly.js", "dist/sdk-host.js", "dist/startup.js", "dist/runtime.js", "dist/owned-sdk.js", "dist/types/src/*.d.ts", "locale/*.json", "plugin.patch.yml", "icon.svg", "LICENSE", "README.md", "README.zh.md"],
  "icon": "icon.svg",
  "dsh": { "bundle": { "patch": "./plugin.patch.yml" } },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*", "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3", "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.3", "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3", "@deepseek-ai/dsh-sdk-client": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "0.2.1-rc.3", "@deepseek-ai/dsh-sdk-protocol": "0.2.1-rc.3",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.3", "@modelcontextprotocol/client": "2.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true }, "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true }, "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-fs": { "optional": true }, "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true }, "@deepseek-ai/dsh-sdk-client": { "optional": true },
    "@deepseek-ai/dsh-sdk-jsonrpc-server": { "optional": true }, "@deepseek-ai/dsh-sdk-protocol": { "optional": true },
    "@deepseek-ai/dsh-mcp-client": { "optional": true }, "@modelcontextprotocol/client": { "optional": true }
  }
}
