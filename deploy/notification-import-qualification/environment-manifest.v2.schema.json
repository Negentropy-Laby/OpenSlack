{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openslack.dev/schemas/notification-post-import-qualification-environment-manifest.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "recorded_at",
    "gate",
    "scope",
    "prerequisite_gates",
    "workflow",
    "timeout_minutes",
    "order_decision",
    "external_inputs_after",
    "repository_preflight",
    "repositories",
    "environment",
    "fixed_variables",
    "pending_variables",
    "required_secrets",
    "preflight",
    "does_not_claim"
  ],
  "properties": {
    "schema": {
      "const": "openslack.notification_import_qualification_environment_manifest.v2"
    },
    "status": {
      "const": "PENDING_EXTERNAL"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "gate": {
      "const": "G5-POST-IMPORT-QUALIFICATION"
    },
    "scope": {
      "const": "IB7_EVALUATION_ONLY"
    },
    "prerequisite_gates": {
      "const": ["G3-QUEUE", "IB6-HISTORY-IMPORT", "IB6-MERGE-TRAIN/PX2-EXIT", "G4-E2E"]
    },
    "workflow": {
      "const": ".github/workflows/notification-import-qualification.yml"
    },
    "timeout_minutes": {
      "const": 60
    },
    "order_decision": {
      "const": "integration/gates/ib6-repository-import-order-supersession.json"
    },
    "external_inputs_after": {
      "const": "IB6-MERGE-TRAIN/PX2-EXIT"
    },
    "repository_preflight": {
      "const": {
        "required_ref": "refs/heads/main",
        "checkout_ref_source": "expected_commit",
        "checkout_persist_credentials": false,
        "required_directory": "services/notification-delivery",
        "required_receipt": "integration/gates/ib6-history-import.json"
      }
    },
    "repositories": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/repositoryA"
        },
        {
          "$ref": "#/$defs/repositoryB"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "name", "required_reviewer", "deployment_branch"],
      "properties": {
        "repository": {
          "const": "Negentropy-Laby/OpenSlack"
        },
        "name": {
          "const": "notification-canary"
        },
        "required_reviewer": {
          "const": "wsman"
        },
        "deployment_branch": {
          "const": "main"
        }
      }
    },
    "fixed_variables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "CANARY_REPO_A",
        "CANARY_REPO_B",
        "CANARY_VENDOR_SLACK",
        "CANARY_VENDOR_WEBHOOK",
        "CANARY_ROUTE_SLACK",
        "CANARY_ROUTE_WEBHOOK",
        "CANARY_ROUTING_EPOCH"
      ],
      "properties": {
        "CANARY_REPO_A": {
          "const": "Negentropy-Laby/openslack-notification-canary-a"
        },
        "CANARY_REPO_B": {
          "const": "Negentropy-Laby/openslack-notification-canary-b"
        },
        "CANARY_VENDOR_SLACK": {
          "const": "openslack-slack"
        },
        "CANARY_VENDOR_WEBHOOK": {
          "const": "openslack-webhook"
        },
        "CANARY_ROUTE_SLACK": {
          "const": "slack-primary"
        },
        "CANARY_ROUTE_WEBHOOK": {
          "const": "webhook-primary"
        },
        "CANARY_ROUTING_EPOCH": {
          "const": "1"
        }
      }
    },
    "pending_variables": {
      "const": [
        "CANARY_GITHUB_APP_ID",
        "CANARY_GITHUB_APP_INSTALLATION_ID",
        "CANARY_QUALIFICATION_RUNNER",
        "CANARY_WORKSPACE_ROOT",
        "CANARY_EVIDENCE_ROOT",
        "CANARY_WATCH_CONFIG_PATH",
        "CANARY_VENDOR_EVIDENCE_DIR",
        "CANARY_HOST",
        "CANARY_HOST_USER",
        "CANARY_WEBHOOK_ORIGIN",
        "CANARY_IMAGE",
        "CANARY_SLACK_CHANNEL",
        "NOTIFICATION_SERVICE_ORIGIN",
        "NOTIFICATION_SERVICE_COMMIT",
        "NOTIFICATION_SERVICE_TREE",
        "NOTIFICATION_SERVICE_DEPLOYMENT_DIGEST"
      ]
    },
    "required_secrets": {
      "const": ["CANARY_GITHUB_APP_PRIVATE_KEY", "HANDOFF_CALLER_KEY", "CANARY_AUDITOR_KEY"]
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linux_host",
        "postgresql",
        "prometheus",
        "webhook_receiver",
        "slack_app_channel",
        "caller_auditor_scope",
        "two_vendors_active"
      ],
      "properties": {
        "linux_host": {
          "const": "PENDING_EXTERNAL"
        },
        "postgresql": {
          "const": "PENDING_EXTERNAL"
        },
        "prometheus": {
          "const": "PENDING_EXTERNAL"
        },
        "webhook_receiver": {
          "const": "PENDING_EXTERNAL"
        },
        "slack_app_channel": {
          "const": "PENDING_EXTERNAL"
        },
        "caller_auditor_scope": {
          "const": "PENDING_EXTERNAL"
        },
        "two_vendors_active": {
          "const": "PENDING_EXTERNAL"
        }
      }
    },
    "does_not_claim": {
      "const": [
        "G5_POST_IMPORT_QUALIFICATION_PASS",
        "LIVE_VERIFIED",
        "IB7_CUTOVER",
        "OPENSLACK_0_2_0_RELEASE",
        "OPENSLACK_0_3_0_RELEASE",
        "PRODUCTION_READY",
        "REPOSITORY_ARCHIVE",
        "DESTRUCTIVE_RETIREMENT"
      ]
    }
  },
  "$defs": {
    "repositoryA": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_name", "visibility", "event_branch", "issues_required"],
      "properties": {
        "full_name": {
          "const": "Negentropy-Laby/openslack-notification-canary-a"
        },
        "visibility": {
          "const": "private"
        },
        "event_branch": {
          "const": "canary-events"
        },
        "issues_required": {
          "const": true
        }
      }
    },
    "repositoryB": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_name", "visibility", "event_branch", "issues_required"],
      "properties": {
        "full_name": {
          "const": "Negentropy-Laby/openslack-notification-canary-b"
        },
        "visibility": {
          "const": "private"
        },
        "event_branch": {
          "const": "canary-events"
        },
        "issues_required": {
          "const": true
        }
      }
    }
  }
}
