{
  "mcpServers": {
    "openslack": {
      "type": "stdio",
      "command": "bun",
      "args": [
        "--cwd",
        "/absolute/path/with spaces/OpenSlack",
        "run",
        "openslack",
        "mcp",
        "serve",
        "--stdio",
        "--profile",
        "agent-bound",
        "--principal-ref",
        "<agent-id>"
      ]
    }
  }
}
