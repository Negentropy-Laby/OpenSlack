{
  "mcpServers": {
    "openslack": {
      "type": "stdio",
      "command": "bun",
      "args": [
        "--cwd",
        "/absolute/path/with spaces/OpenSlack",
        "run",
        "openslack",
        "mcp",
        "serve",
        "--stdio",
        "--profile",
        "human-attested",
        "--principal-ref",
        "<agent-id>",
        "--human-principal",
        "<human-id>"
      ]
    }
  }
}
