{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openslack.dev/schemas/documentation/project-state.schema.json",
  "title": "OpenSlack portfolio project state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "updated",
    "last_verified",
    "portfolio_status",
    "release_train",
    "modules",
    "workstreams"
  ],
  "properties": {
    "schema": { "const": "openslack.project_state.v1" },
    "updated": { "type": "string", "format": "date" },
    "last_verified": { "type": "string", "format": "date-time" },
    "portfolio_status": {
      "enum": ["planned", "active_development", "stabilization", "maintenance", "archived"]
    },
    "release_train": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stateItem" }
    },
    "workstreams": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stateItem" }
    }
  },
  "$defs": {
    "stateItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "stage", "maturity", "blockers", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "stage": {
          "enum": [
            "Concept",
            "Specification",
            "Architecture",
            "Implementation",
            "Verification",
            "Release",
            "Maintenance"
          ]
        },
        "maturity": {
          "enum": ["planned", "implemented", "local_ready", "live_verified", "production_ready"]
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
