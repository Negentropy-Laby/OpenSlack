{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openslack.dev/schemas/documentation/document-map.schema.json",
  "title": "OpenSlack document authority map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authorities", "documents"],
  "properties": {
    "schema": { "const": "openslack.document_map.v1" },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact", "canonical"],
        "properties": {
          "fact": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
          "canonical": { "$ref": "#/$defs/path" },
          "projections": { "$ref": "#/$defs/pathList" },
          "indexes": { "$ref": "#/$defs/pathList" },
          "archives": { "$ref": "#/$defs/pathList" }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "path": { "$ref": "#/$defs/path" },
          "status": { "enum": ["active", "generated", "index", "archived"] }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "pathList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    }
  }
}
