{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openslack.dev/schemas/documentation/document-path-migration.schema.json",
  "title": "OpenSlack document path migration manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "phase", "baseline_document_count", "entries"],
  "properties": {
    "schema": { "const": "openslack.document_path_migration.v1" },
    "phase": { "enum": ["planning", "migrated"] },
    "baseline_document_count": { "type": "integer", "minimum": 1 },
    "reference_exceptions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "old_path", "new_path", "document_id", "migration_type"],
        "properties": {
          "id": { "type": "string", "pattern": "^DPM-[0-9]{3}$" },
          "old_path": { "$ref": "#/$defs/path" },
          "new_path": { "$ref": "#/$defs/path" },
          "document_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "migration_type": {
            "enum": ["retained", "moved", "archived", "replaced", "generated"]
          }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
